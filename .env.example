# Backend: Supabase Configuration (required for Next.js API routes)
# These are SERVICE credentials - NEVER expose in browser
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# GitHub (for CI/CD, optional for local development)
GITHUB_TOKEN=ghp_xxx...

# LLM Agents (Phase 2: LangGraph + Claude)
ANTHROPIC_API_KEY=sk-ant-xxx...
LLM_MODEL=claude-3-5-haiku-20241022
LLM_TEMPERATURE=0.3

# Environment
NODE_ENV=development

# IMPORTANT: Frontend does NOT need NEXT_PUBLIC_SUPABASE_*
# All frontend <-> database communication goes through API routes (/api/*)
# This ensures:
# - Credentials stay private (not exposed in browser)
# - Single backend access pattern
# - Easier to add authentication/authorization later
