# Manukora Superpowers Configuration
# Enables Claude Code skills for this full-stack project

# Frontend design and component architecture
plugins:
  - frontend-design

# Code quality and review
skills:
  - plugin:pr-review-toolkit:code-reviewer
  - plugin:pr-review-toolkit:comment-analyzer
  - plugin:pr-review-toolkit:silent-failure-hunter
  - plugin:pr-review-toolkit:type-design-analyzer

# Feature development workflow
  - plugin:feature-dev:code-architect
  - plugin:feature-dev:code-explorer
  - plugin:feature-dev:code-reviewer

# Code simplification and refactoring
  - plugin:code-simplifier:code-simplifier

# TypeScript language support
  - plugin:typescript-lsp

# Git and commit management
  - plugin:commit-commands
